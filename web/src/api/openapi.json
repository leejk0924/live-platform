{
  "openapi": "3.1.0",
  "info": {
    "title": "live-platform API",
    "description": "Errors are always `{code, message, traceId}` (`ErrorBody`). Every POST, PUT, PATCH and DELETE must send an allowed `Origin` and `X-Requested-With: live-platform`, or it is rejected with 403 `CSRF_REJECTED`. Ids are decimal strings.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/demo": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Whether demo login is enabled",
        "operationId": "getDemoStatus",
        "responses": {
          "200": {
            "description": "Demo login availability.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/demo-login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in to a demo account",
        "operationId": "demoLogIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "`__Host-session=<token>; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=604800`"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "`INVALID_REQUEST`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`CSRF_REJECTED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`NOT_FOUND`: demo login is disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`RATE_LIMITED`",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Seconds to wait"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in with a password",
        "operationId": "logIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; any session the request carried is revoked.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "`__Host-session=<token>; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=604800`"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "`INVALID_REQUEST`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "`INVALID_CREDENTIALS`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`CSRF_REJECTED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`RATE_LIMITED`",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Seconds to wait"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign out; succeeds without a session too",
        "operationId": "logOut",
        "responses": {
          "204": {
            "description": "Signed out.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Clears the session cookie"
              }
            }
          },
          "403": {
            "description": "`CSRF_REJECTED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in user",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "The signed-in user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/auth/signup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create an account and sign in",
        "operationId": "signUp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Signed up and signed in.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "`__Host-session=<token>; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=604800`"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "`INVALID_USERNAME`, `PASSWORD_TOO_SHORT`, `PASSWORD_TOO_LONG`, `PASSWORD_BREACHED` or `INVALID_REQUEST`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`CSRF_REJECTED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`USERNAME_TAKEN`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`RATE_LIMITED`",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Seconds to wait"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/broadcasts": {
      "get": {
        "tags": [
          "broadcasts"
        ],
        "summary": "List broadcasts, newest first",
        "operationId": "listBroadcasts",
        "parameters": [
          {
            "name": "before",
            "in": "query",
            "description": "Only broadcasts older than this id: the previous page's `nextBefore`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1 to 50. Defaults to 20.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 50,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The same for every viewer.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "`public, max-age=5`"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BroadcastPage"
                }
              }
            }
          },
          "400": {
            "description": "`INVALID_QUERY` or `INVALID_PAGE_SIZE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "broadcasts"
        ],
        "summary": "Register a broadcast owned by the signed-in user",
        "operationId": "createBroadcast",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BroadcastInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created in `READY` at version 1.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "`\"1\"`"
              },
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "`/api/broadcasts/<id>`"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Broadcast"
                }
              }
            }
          },
          "400": {
            "description": "`INVALID_TITLE`, `INVALID_DESCRIPTION` or `INVALID_REQUEST`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`CSRF_REJECTED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/broadcasts/{id}": {
      "get": {
        "tags": [
          "broadcasts"
        ],
        "summary": "Get one broadcast",
        "operationId": "getBroadcast",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Broadcast id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The broadcast.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "The version as `\"<version>\"`"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Broadcast"
                }
              }
            }
          },
          "404": {
            "description": "`BROADCAST_NOT_FOUND`, also for deleted broadcasts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "broadcasts"
        ],
        "summary": "Replace title and description; owner only",
        "operationId": "updateBroadcast",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Broadcast id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "The version being edited, as returned in `ETag`: `\"3\"` (`W/\"3\"` is accepted)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BroadcastInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "The new version"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Broadcast"
                }
              }
            }
          },
          "400": {
            "description": "`IF_MATCH_REQUIRED`, `INVALID_IF_MATCH`, `INVALID_TITLE`, `INVALID_DESCRIPTION` or `INVALID_REQUEST`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHENTICATED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`NOT_BROADCAST_OWNER` or `CSRF_REJECTED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`BROADCAST_NOT_FOUND`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`VERSION_CONFLICT`: changed since it was loaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      },
      "delete": {
        "tags": [
          "broadcasts"
        ],
        "summary": "Delete a READY or ENDED broadcast; owner only",
        "operationId": "deleteBroadcast",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Broadcast id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "`UNAUTHENTICATED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`NOT_BROADCAST_OWNER` or `CSRF_REJECTED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`BROADCAST_NOT_FOUND`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`BROADCAST_NOT_DELETABLE`: live or interrupted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Broadcast": {
        "type": "object",
        "required": [
          "id",
          "ownerId",
          "ownerName",
          "title",
          "description",
          "status",
          "version",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Snowflake id as a decimal string.",
            "example": "112007303372210176"
          },
          "ownerId": {
            "type": "string",
            "example": "112007302751453184"
          },
          "ownerName": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/BroadcastStatus"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Send back as `If-Match: \"<version>\"` to update.",
            "minimum": 1
          }
        }
      },
      "BroadcastInput": {
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "At most 2000 characters; may be empty."
          },
          "title": {
            "type": "string",
            "description": "Trimmed, then 1 to 100 characters."
          }
        }
      },
      "BroadcastPage": {
        "type": "object",
        "required": [
          "items",
          "nextBefore"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Broadcast"
            }
          },
          "nextBefore": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `before` for the next page; `null` on the last page."
          }
        }
      },
      "BroadcastStatus": {
        "type": "string",
        "enum": [
          "READY",
          "LIVE",
          "INTERRUPTED",
          "ENDED"
        ]
      },
      "Credentials": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "format": "password",
            "description": "10 to 128 characters."
          },
          "username": {
            "type": "string",
            "description": "3 to 20 characters of `a-z`, `0-9`, `_` and `-`."
          }
        }
      },
      "DemoAccount": {
        "type": "string",
        "enum": [
          "streamer",
          "viewer"
        ]
      },
      "DemoLoginRequest": {
        "type": "object",
        "required": [
          "account"
        ],
        "properties": {
          "account": {
            "$ref": "#/components/schemas/DemoAccount"
          }
        }
      },
      "DemoStatus": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The body of every error response.",
        "required": [
          "code",
          "message",
          "traceId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable SCREAMING_SNAKE identifier to match on, such as `VERSION_CONFLICT`."
          },
          "message": {
            "type": "string",
            "description": "Human-readable; do not match on it."
          },
          "traceId": {
            "type": "string",
            "description": "Also in the `x-trace-id` header; quote it when reporting a problem."
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Snowflake id as a decimal string.",
            "example": "112007302751453184"
          },
          "username": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-session",
        "description": "Set by signup, login and demo-login; HttpOnly, so browsers send it themselves."
      }
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Accounts and sessions"
    },
    {
      "name": "broadcasts",
      "description": "Broadcast registration and browsing"
    }
  ]
}
