# Postgres 데이터베이스 이름
POSTGRES_DB=live_platform
# Postgres 접속 사용자
POSTGRES_USER=live_platform
# Postgres 비밀번호 (URL에 들어가므로 영숫자만 사용)
POSTGRES_PASSWORD=change-me
# Let's Encrypt 계정 이메일 (로컬은 내부 인증서라 쓰이지 않음)
ACME_EMAIL=change-me@example.com
# 운영 도메인 (compose.prod.yml에서만 사용)
DOMAIN=change-me.duckdns.org
# 운영 서버 공인 IP, WebRTC ICE 후보로 알림 (compose.prod.yml에서만 사용)
PUBLIC_IP=change-me
# 데모 계정 로그인 허용 여부 (true 또는 false)
DEMO_LOGIN_ENABLED=false
