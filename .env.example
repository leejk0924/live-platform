# Postgres 데이터베이스 이름
POSTGRES_DB=live_platform
# Postgres 접속 사용자
POSTGRES_USER=live_platform
# Postgres 비밀번호 (URL에 들어가므로 영숫자만 사용)
POSTGRES_PASSWORD=change-me
# Let's Encrypt 계정 이메일 (로컬은 내부 인증서라 쓰이지 않음)
ACME_EMAIL=change-me@example.com
# 운영 도메인 (compose.prod.yml에서만 사용)
DOMAIN=change-me.duckdns.org
# 운영 서버 공인 IP, WebRTC ICE 후보로 알림 (compose.prod.yml에서만 사용)
PUBLIC_IP=change-me
# 데모 계정 로그인 허용 여부 (true 또는 false)
DEMO_LOGIN_ENABLED=false
# 송출 JWT 서명 키(Ed25519 seed 32바이트, 표준 base64). 생성: openssl rand -base64 32
PUBLISH_JWT_PRIVATE_KEY=change-me
# MediaMTX가 API의 /internal/media/*를 부를 때 내는 공유 비밀값(영문·숫자 32자 이상). 생성: openssl rand -hex 32
MEDIA_HOOK_SECRET=change-me
# 녹화 저장 방식: local(기본, API 호스트 디스크) 또는 s3(S3 + CloudFront). local은 아래 값이 필요 없음
# RECORDING_STORAGE=local
# MediaMTX가 세그먼트를 남기는 스풀 디렉터리 (기본 /recordings)
# RECORDING_SPOOL_DIR=/recordings
# local 저장 디렉터리 (기본 /recording-store)
# RECORDING_STORE_DIR=/recording-store
# s3: S3 호환 엔드포인트, 리전, 버킷 (경로 방식 주소)
# S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
# S3_REGION=ap-northeast-2
# S3_BUCKET=change-me
# s3: 업로드용 IAM 사용자 정적 키 (버킷 PutObject 권한만)
# S3_ACCESS_KEY_ID=change-me
# S3_SECRET_ACCESS_KEY=change-me
# s3: 녹화를 내주는 CloudFront 배포(OAC) 도메인과 서명 키 쌍 ID
# CLOUDFRONT_DOMAIN=change-me.cloudfront.net
# CLOUDFRONT_KEY_PAIR_ID=change-me
# s3: CloudFront URL 서명용 ECDSA P-256 개인키 PEM (생성: openssl ecparam -name prime256v1 -genkey -noout)
# CLOUDFRONT_PRIVATE_KEY=change-me
# s3: CSP media-src에 더할 CloudFront 출처 (compose.prod.yml에서만 사용). 출처 하나만, https://host 형식.
# 경로, 공백, ;를 넣지 않는다. 값이 그대로 CSP 헤더에 들어가 다른 지시어를 덧붙일 수 있다. 예: https://change-me.cloudfront.net
# RECORDING_MEDIA_ORIGIN=
