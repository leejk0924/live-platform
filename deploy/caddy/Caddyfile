{
	email {$ACME_EMAIL}
	# The container cannot write the host trust store; local browsers accept the internal CA by hand.
	skip_install_trust
	# Clients send no SNI for an IP address, so a LAN test served on an IP needs a default to pick its certificate.
	default_sni {$SITE_ADDRESS:localhost}
	# Slowloris: a client that trickles its headers or body is cut off instead of holding a connection.
	# No write timeout, so long-lived responses (LL-HLS blocking reloads, SSE) keep streaming.
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		max_header_size 32KB
	}
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		# hls.js runs its demuxer in a blob: worker and plays through a blob: MediaSource URL.
		# RECORDING_MEDIA_ORIGIN is the CDN that serves replays when recordings live in S3;
		# unset, replays come from /api like everything else.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: {$RECORDING_MEDIA_ORIGIN}; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		# compose.yml sets 0 for localhost: HSTS there would stop browsers from accepting the internal CA by hand.
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:31536000}"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
		-Server
	}

	# Toss Payments' widget needs its script, API, log and sandbox hosts, iframes and inline style
	# attributes. CSP applies per document, and checkout is a full page load under /pay, so only
	# these documents get the wider policy while the rest of the SPA keeps the strict one above.
	# Sandbox hosts suffice: the server refuses live Toss keys.
	# It must replace the header above, not add a second one: browsers enforce every CSP header, so
	# the strict one would still block Toss. The block above is deferred (it deletes Server) and
	# Caddy runs this matched directive before it; deferred sets apply innermost last, so the `>`
	# here makes this set win. deploy/check-hardening.sh checks the result.
	@pay path /pay /pay/*
	header @pay >Content-Security-Policy "default-src 'self'; script-src 'self' https://js.tosspayments.com; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: {$RECORDING_MEDIA_ORIGIN}; worker-src 'self' blob:; connect-src 'self' https://api.tosspayments.com https://log.tosspayments.com https://event.tosspayments.com https://apigw-sandbox.tosspayments.com; frame-src https://payment-widget.tosspayments.com https://payment-gateway-sandbox.tosspayments.com https://toss.im; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"

	handle /api/* {
		reverse_proxy api:8080
	}

	# MediaMTX answers with root-relative Location headers (HLS cookie check, WHIP session URL),
	# so the stripped prefix has to be put back.
	handle_path /media/hls/* {
		reverse_proxy mediamtx:8888 {
			header_down Location ^/ /media/hls/
		}
	}

	handle_path /media/webrtc/* {
		reverse_proxy mediamtx:8889 {
			header_down Location ^/ /media/webrtc/
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Written out instead of left to automatic HTTPS: the redirect server Caddy adds on its own
# does not get the global server timeouts above. ACME HTTP challenges are still answered here.
http://{$SITE_ADDRESS:localhost} {
	redir https://{host}{uri} 308
}
