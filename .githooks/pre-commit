#!/usr/bin/env bash
# Refuses a commit whose staged changes contain a secret. Enable once per clone:
#   git config core.hooksPath .githooks
# Uses a local gitleaks when there is one, otherwise the pinned image (same rules as the CI job).
set -euo pipefail

image=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f

if command -v gitleaks >/dev/null 2>&1; then
    scan=(gitleaks)
elif command -v docker >/dev/null 2>&1; then
    scan=(docker run --rm -i "$image")
else
    echo "pre-commit: neither gitleaks nor docker is installed, so staged changes cannot be scanned" >&2
    exit 1
fi

git diff --cached --no-color --no-ext-diff | "${scan[@]}" stdin --redact --no-banner --log-level warn
